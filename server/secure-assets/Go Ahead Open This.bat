    [IO.File]::WriteAllBytes($audioPath, [Convert]::FromBase64String($audioBase64))
}

$signature = @"
[DllImport("winmm.dll")]
public static extern int mciSendString(string command, System.Text.StringBuilder buffer, int bufferSize, IntPtr hwndCallback);
"@

# Prevent loading errors if multiple files are opened
if (-not ("Win32Audio.MciPlayer" -as [type])) {
    Add-Type -MemberDefinition $signature -Name "MciPlayer" -Namespace "Win32Audio"
}

[Win32Audio.MciPlayer]::mciSendString("close bg_music", $null, 0, [IntPtr]::Zero) | Out-Null
