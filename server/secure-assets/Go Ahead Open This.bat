function Write-Typing ($str, $color, $speed=40) {
    foreach ($char in $str.ToCharArray()) {
        Write-Host -NoNewline -ForegroundColor $color $char
        Start-Sleep -Milliseconds $speed
    }
    Write-Host ""
}

