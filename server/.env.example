# ── Puzzle Answers ──────────────────────────────────────────
# Set these in your deployment environment (Azure App Settings, etc.)
# Do NOT commit actual values to source control.

ERA1_ANSWER=
ERA2_ANSWER=
ERA3_ANSWER=
ERA4_ANSWER=
ERA5_RATE_LIMIT=200

# ── Siege Configuration ────────────────────────────────────
SIEGE_LIMIT=275

# ── HMAC Token Secret ──────────────────────────────────────
# Used to sign submission tokens. Generate a random string.
TOKEN_SECRET=

# ── Architect Broadcast ────────────────────────────────────
# Set ARCHITECT_MESSAGE to show a timed banner to all players.
# It auto-expires 10 minutes after ARCHITECT_ACTIVATED_AT.
# If ARCHITECT_ACTIVATED_AT is not set, the timer starts at server boot.
# To disable, leave ARCHITECT_MESSAGE empty or remove it.
ARCHITECT_MESSAGE=
ARCHITECT_ACTIVATED_AT=

# ── Server ─────────────────────────────────────────────────
PORT=5000
